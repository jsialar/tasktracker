{
  // Used by the editor and `npm run typecheck` (covers src and tests).
  // `npm run build` uses tsconfig.build.json, which only compiles src.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Lets imports name the real file (`./db.ts`); the build rewrites them to `.js`.
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
