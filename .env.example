# Copy this file to .env and fill in the values. .env is ignored by git.

# Google Gemini API key, used to identify skills for tasks created without any.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: the Gemini model to use (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Optional: host ports, if the defaults are already in use on your machine
# FRONTEND_PORT=8080
# DB_PORT=5433
# If you change DB_PORT and run the backend outside Docker, also set:
# DATABASE_URL=postgres://postgres:postgres@localhost:<DB_PORT>/taskdb
